rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos are shown on the public site, so anyone may read them. Only signed-in team members may upload, into their own folder.
    match /photos/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.get('role', '') in ['owner', 'carowner', 'member']
        && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.token.get('role', '') == 'owner');
    }
  }
}
